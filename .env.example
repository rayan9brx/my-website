# Copy to .env.local for local development. Never commit real values.

# Anthropic API key (server only). Required for the AI console.
ANTHROPIC_API_KEY=
# Model name. Defaults to claude-haiku-5-5 when empty.
ANTHROPIC_MODEL=
# Kill switch: set to "false" to turn the AI chat off without a deploy.
CHAT_ENABLED=
# Max chat requests per day across all visitors. Defaults to 300.
CHAT_DAILY_LIMIT=
# Public site URL (e.g. https://example.vercel.app), allowed as request origin.
SITE_URL=
# Long random string used to hash visitor IPs before rate limiting.
IP_HASH_SALT=
# Upstash Redis REST URL. Without it the unreliable in-memory limiter is used.
UPSTASH_REDIS_REST_URL=
# Upstash Redis REST token.
UPSTASH_REDIS_REST_TOKEN=
# Resend API key (server only). Required for the contact form.
RESEND_API_KEY=
# Inbox that receives contact form messages.
CONTACT_TO_EMAIL=
# Verified Resend sender, e.g. "Portfolio <contact@your-domain.com>".
CONTACT_FROM_EMAIL=
